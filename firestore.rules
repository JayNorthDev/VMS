rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin'; 
    }

    match /users/{userId} { allow read, write: if isSignedIn(); }
    match /visitorEntries/{docId} { allow read, write: if isSignedIn(); }
    match /divisions/{divId} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /audit_logs/{logId} { allow read, write: if isSignedIn(); }

    // Collection Group explicit allow - fixes "list" permission errors for dashboards
    match /{document=**}/cards/{cardId} { allow read, write: if isSignedIn(); }
    
    // Explicit path for prefixed card sub-collections
    match /generated_id_cards/{prefix}/cards/{cardId} { allow read, write: if isSignedIn(); }
  }
}